# 服务器配置
NODE_ENV=development
PORT=3000
HOST=localhost

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=english_learning
DB_USER=root
DB_PASSWORD=

# JWT 配置
