# 服务器配置
NODE_ENV=development
PORT=3000
HOST=localhost

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=english_learning
DB_USER=root
DB_PASSWORD=123456

# Prisma 数据库连接 URL（格式：mysql://用户名:密码@主机:端口/数据库名）
DATABASE_URL="mysql://root:123456@localhost:3306/english_learning?charset=utf8mb4&connection_limit=10"

# JWT 配置
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# 文件上传配置
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# 日志配置
LOG_LEVEL=info

# CORS 配置
CORS_ORIGIN=http://localhost:8080,http://localhost:5173,http://localhost:5174

# 第三方服务（可选）
# Google TTS API
GOOGLE_TTS_API_KEY=your_api_key

# 邮件服务（可选）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_password
