{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "English Learning",
        "navigationBarBackgroundColor": "#4CAF50",
        "navigationBarTextStyle": "white",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "Login",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/vocabularies/index",
      "style": {
        "navigationBarTitleText": "Learn",
        "navigationBarBackgroundColor": "#4CAF50",
        "navigationBarTextStyle": "white",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/vocabulary-detail/index",
      "style": {
        "navigationBarTitleText": "Vocabulary",
        "navigationBarBackgroundColor": "#4CAF50",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/progress/index",
      "style": {
        "navigationBarTitleText": "Progress",
        "navigationBarBackgroundColor": "#4CAF50",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "Profile",
        "navigationBarBackgroundColor": "#4CAF50",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/design-converter/index",
      "style": {
        "navigationBarTitleText": "Design Converter",
        "navigationBarBackgroundColor": "#4CAF50",
        "navigationBarTextStyle": "white",
        "enablePullDownRefresh": false
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "English Learning",
    "navigationBarBackgroundColor": "#4CAF50",
    "backgroundColor": "#f9fafb",
    "backgroundTextStyle": "light",
    "app-plus": {
      "titleNView": false
    }
  },
  "tabBar": {
    "color": "#9ca3af",
    "selectedColor": "#4CAF50",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "height": "56px",
    "fontSize": "12px",
    "spacing": "4px",
    "iconWidth": "24px",
    "midButton": false,
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "Home",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/vocabularies/index",
        "text": "Learn",
        "iconPath": "static/tabbar/learn.png",
        "selectedIconPath": "static/tabbar/learn-active.png"
      },
      {
        "pagePath": "pages/progress/index",
        "text": "Progress",
        "iconPath": "static/tabbar/progress.png",
        "selectedIconPath": "static/tabbar/progress-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "Profile",
        "iconPath": "static/tabbar/profile.png",
        "selectedIconPath": "static/tabbar/profile-active.png"
      }
    ]
  }
}
